{
  "expo": {
    "name": "Asim Ali",
    "slug": "asimali",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "asimali",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#222A36",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.asimali.portfolio",
      "associatedDomains": [
        "applinks:asimali.net",
        "applinks:www.asimali.net"
      ]
    },
    "android": {
      "package": "net.asimali.portfolio",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#222A36"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "asimali.net"
            },
            {
              "scheme": "https",
              "host": "www.asimali.net"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#222A36",
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1ba92c10-79d5-4a09-9538-4a5ad0d54fe6"
      }
    },
    "owner": "imasimali",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1ba92c10-79d5-4a09-9538-4a5ad0d54fe6"
    }
  }
}
